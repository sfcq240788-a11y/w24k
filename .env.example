# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REEMPLAZAR_CON_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_CON_SERVICE_ROLE_KEY

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=REEMPLAZAR_CON_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REEMPLAZAR_CON_PUBLISHABLE_KEY

# Stripe webhook — lo imprime `stripe listen` en local
STRIPE_WEBHOOK_SECRET=REEMPLAZAR_CON_WEBHOOK_SECRET

# URL base del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos con acceso al panel admin, separados por coma
ADMIN_EMAILS=correo@ejemplo.com